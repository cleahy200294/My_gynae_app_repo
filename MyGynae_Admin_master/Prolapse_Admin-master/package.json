{
  "private": true,
  "overrides": {
    "@react-pdf/layout": "3.1.2",
    "@react-pdf/textkit": "4.0.0"
  },
  "scripts": {
    "start": "umi dev",
    "build": "umi build",
    "postinstall": "umi generate tmp",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "test": "umi-test",
    "test:coverage": "umi-test --coverage"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "dependencies": {
    "@ant-design/charts": "^1.4.2",
    "@ant-design/icons": "^4.7.0",
    "@ant-design/pro-components": "^2.3.12",
    "@react-pdf/renderer": "2.3.0",
    "antd": "^4.23.1",
    "array-move": "^4.0.0",
    "md5": "^2.3.0",
    "rc-field-form": "^2.7.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-signature-canvas": "^1.0.6",
    "react-sortable-hoc": "^2.0.0",
    "reactflow": "^11.2.0",
    "swr": "1.3.0",
    "umi": "^3.5.21",
    "uuid": "^9.0.0",
    "yoga-layout-prebuilt": "^1.10.0"
  },
  "devDependencies": {
    "@types/md5": "^2.3.2",
    "@types/react": "^18.0.18",
    "@types/react-dom": "^18.0.6",
    "@types/react-signature-canvas": "^1.0.2",
    "@types/uuid": "^8.3.4",
    "@umijs/preset-react": "1.x",
    "@umijs/test": "^3.5.21",
    "file-loader": "^6.2.0",
    "lint-staged": "^10.0.7",
    "prettier": "^2.2.0",
    "typescript": "^4.1.2",
    "yorkie": "^2.0.0"
  }
}
